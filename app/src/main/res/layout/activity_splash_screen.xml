<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nirmana_bg_dark"
    tools:context=".SplashScreenActivity">


    <ImageView
        android:id="@+id/logo_nirmana_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_nirmana_icon" />

    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/masfuad"
        android:letterSpacing="0.08"
        android:text="NIRMANA"
        android:textColor="@color/nirmana_cream"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_nirmana_icon" />


    <ImageView
        android:id="@+id/imgKiri"
        android:layout_width="135dp"
        android:layout_height="190dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="130dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAppName"
        app:srcCompat="@drawable/warna" />

    <ImageView
        android:id="@+id/imgKanan"
        android:layout_width="100dp"
        android:layout_height="190dp"
        android:layout_marginTop="130dp"
        android:layout_marginEnd="36dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAppName"
        app:srcCompat="@drawable/mawar" />

    <ImageView
        android:id="@+id/imgTengah"
        android:layout_width="145dp"
        android:layout_height="200dp"
        android:layout_marginTop="36dp"
        android:elevation="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAppName"
        app:srcCompat="@drawable/gunung" />


    <TextView
        android:id="@+id/txtTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/masrian"
        android:text="Jelajahi karya visual digital"
        android:textColor="@color/nirmana_cream"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@+id/txtSubTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtSubTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="Temukan referensi dan kenali pembuatnya"
        android:textColor="@color/nirmana_gray"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@+id/btnJelajahi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnJelajahi"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:background="@color/nirmana_mint"
        android:text="Jelajahi Karya"
        android:textAllCaps="false"
        android:textColor="@color/nirmana_bg_dark"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>