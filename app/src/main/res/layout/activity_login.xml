<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nirmana_bg_dark"
    tools:context=".LoginActivity">


    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_nirmana_icon" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/masfuad"
        android:letterSpacing="0.08"
        android:text="NIRMANA"
        android:textColor="@color/nirmana_cream"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView6" />


    <ImageView
        android:id="@+id/imgLoginKiri"
        android:layout_width="105dp"
        android:layout_height="140dp"
        android:layout_marginTop="48dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toStartOf="@+id/imgLoginTengah"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/daragon" />

    <ImageView
        android:id="@+id/imgLoginTengah"
        android:layout_width="115dp"
        android:layout_height="170dp"
        android:layout_marginTop="18dp"
        android:elevation="6dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toStartOf="@+id/imgLoginKanan"
        app:layout_constraintStart_toEndOf="@+id/imgLoginKiri"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/tenang" />

    <ImageView
        android:id="@+id/imgLoginKanan"
        android:layout_width="105dp"
        android:layout_height="140dp"
        android:layout_marginTop="48dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgLoginTengah"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/duragon" />


    <TextView
        android:id="@+id/tvSelamatDatang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/masrian"
        android:text="Selamat Datang"
        android:textColor="@color/nirmana_cream"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLoginTengah" />

    <TextView
        android:id="@+id/tvSubSelamatDatang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="Masuk untuk menjelajahi karya visual digital"
        android:textColor="@color/nirmana_gray"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSelamatDatang" />


    <TextView
        android:id="@+id/lblUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:text="Nama Pengguna"
        android:textColor="@color/nirmana_cream"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubSelamatDatang" />

    <EditText
        android:id="@+id/username"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="6dp"
        android:background="#D9D9D9"
        android:hint="Masukkan username"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:textColorHint="#666666"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblUsername" />

    <TextView
        android:id="@+id/lblPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:text="Password"
        android:textColor="@color/nirmana_cream"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/username" />

    <EditText
        android:id="@+id/password"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="6dp"
        android:background="#D9D9D9"
        android:hint="Masukkan password"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:textColorHint="#666666"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblPassword" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:layout_marginBottom="36dp"
        android:background="@color/nirmana_mint"
        android:text="Masuk"
        android:textAllCaps="false"
        android:textColor="@color/nirmana_bg_dark"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>